{
  "name": "crypto-price-tracker",
  "version": "1.0.0",
  "description": "REST API for tracking and aggregating cryptocurrency prices via CoinMarketCap API",
  "main": "dist/index.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  }
}
