# --- HTTP server ---
PORT=3000

# --- Authentication of this API (Authorization: Bearer <key>) ---
# Full access key (read + write). Required. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change-me-to-a-long-random-string
# Optional read-only key: allowed only GET requests.
API_KEY_READONLY=

# --- CoinMarketCap ---
# Required. Get it at https://pro.coinmarketcap.com/account
CMC_API_KEY=
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_TIMEOUT_MS=10000
CMC_MAX_RETRIES=2
CMC_RETRY_BASE_DELAY_MS=500

# --- Prices ---
# Single quote currency for the whole application
PRICE_CURRENCY=USD
# GET /api/v1/prices re-fetches from CoinMarketCap when stored prices are older than this
PRICE_MAX_AGE_MS=60000

# --- Background synchronization ---
SYNC_ENABLED=true
# 300000 (5 min) = ~8.6k requests/month, fits the CoinMarketCap Basic plan (10k credits/month)
SYNC_INTERVAL_MS=300000

# --- Storage ---
DB_PATH=./data/app.db

# --- Logging: debug | info | warn | error ---
LOG_LEVEL=info
